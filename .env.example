# =====================================================
# LoomFlow 环境变量模板
# 复制为 .env.local 并填写你的配置
# =====================================================

# ===== 数据库（Supabase，必填）=====
# Supabase 项目 → Settings → API
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== AI 模型（可选：环境变量回退）=====
# 推荐部署后在「管理后台 → 模型配置」添加模型（模型级 API Key 优先，无需写在这里）
# 如需环境变量回退（如本地开发），可配置：
# https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# ===== 认证密钥（生产必填）=====
# 生成方式：openssl rand -hex 32
AUTH_SECRET=your_random_secret_at_least_32_chars

# ===== 可选：阿里云 OSS（图片上传功能）=====
# 强烈建议使用 RAM 子账号（最小权限：仅目标 bucket 读写）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-shenzhen

# ===== 可选：搜索引擎节点（SearchEngine 执行端点）=====
SEARCH_API_URL=
SEARCH_API_KEY=

# ===== 可选：火山方舟（图片识别视觉模型）=====
ARK_API_KEY=
ARK_MODEL_ID=

# ===== 环境标识 =====
# 开发环境: DEV / 生产环境: PROD
COZE_PROJECT_ENV=DEV

# =====================================================
# Docker 自托管部署（docker compose up -d）
# 非 Docker 环境（本地开发）无需配置以下变量
# =====================================================

# 应用对外端口（macOS 上 5000 常被系统进程占用，可改 5001/5002 等）
PORT=5000

# PostgreSQL 密码（必填）
POSTGRES_PASSWORD=change_me_strong_password

# PostgREST JWT 签名密钥（必填，至少 32 字符）
PGRST_JWT_SECRET=change_me_at_least_32_chars_random

# service_role JWT（必填，用同一密钥生成）：
#   node docker/generate-service-role-key.mjs $PGRST_JWT_SECRET
# 把输出粘贴到 COZE_SUPABASE_SERVICE_ROLE_KEY
# COZE_SUPABASE_SERVICE_ROLE_KEY=eyJ...
