# =====================================================
# LoomFlow 环境变量模板
# 复制为 .env.local 并填写你的配置
# =====================================================

# ===== 数据库（Supabase，必填）=====
# Supabase 项目 → Settings → API
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== AI 模型（可选：环境变量回退）=====
# 推荐部署后在「管理后台 → 模型配置」添加模型（模型级 API Key 优先，无需写在这里）
# 如需环境变量回退（如本地开发），可配置：
# https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# ===== 认证密钥（生产必填）=====
# 生成方式：openssl rand -hex 32
AUTH_SECRET=your_random_secret_at_least_32_chars

# ===== 可选：阿里云 OSS（图片上传功能）=====
# 强烈建议使用 RAM 子账号（最小权限：仅目标 bucket 读写）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-shenzhen

# ===== 可选：搜索引擎节点（SearchEngine 执行端点）=====
SEARCH_API_URL=
SEARCH_API_KEY=

# ===== 可选：火山方舟（图片识别视觉模型）=====
ARK_API_KEY=
ARK_MODEL_ID=

# ===== 运行模式 =====
# Docker 自托管: docker（默认，无需设置）
# Vercel Serverless: serverless
# RUNTIME_MODE=docker

# ===== Vercel Cron 认证（仅 serverless 模式需要）=====
# 生成方式：openssl rand -hex 32
# CRON_SECRET=your_cron_secret_here

# ===== 环境标识 =====
# 开发环境: DEV / 生产环境: PROD
COZE_PROJECT_ENV=DEV

# =====================================================
# Docker 自托管部署（docker compose up -d）
# 非 Docker 环境（本地开发）无需配置以下变量
# =====================================================

# 应用对外端口（macOS 上 5000 常被系统进程占用，可改 5001/5002 等）
PORT=5000

# PostgreSQL 密码（必填）
POSTGRES_PASSWORD=change_me_strong_password

# PostgREST JWT 签名密钥（必填，至少 32 字符）
PGRST_JWT_SECRET=change_me_at_least_32_chars_random

# service_role JWT（必填，用同一密钥生成）：
#   node docker/generate-service-role-key.mjs $PGRST_JWT_SECRET
# 把输出粘贴到 COZE_SUPABASE_SERVICE_ROLE_KEY
# COZE_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =====================================================
# 可选：Python AI 知识服务（services/knowledge-ai，M1 骨架）
# 不填任何一项也不影响现有功能：默认走 Legacy 知识库检索
# =====================================================

# 知识库检索实现选择（预留：M4 起生效，当前版本仅 legacy 生效）
LOOMFLOW_KNOWLEDGE_PROVIDER=legacy

# Node.js 服务端调用 FastAPI 的地址（Docker 网络内）
KNOWLEDGE_SERVICE_URL=http://loomflow-ai:8000

# 内部服务密钥：Node.js 服务端 → FastAPI 的 X-Loomflow-Service-Token
# 生成：openssl rand -hex 32
# 未设置时，--profile python-ai 启动的容器会直接启动失败（不会静默降级）
KNOWLEDGE_SERVICE_TOKEN=

# 可选：宿主机调试端口（仅绑定 127.0.0.1，公网不可达）
# KNOWLEDGE_AI_PORT=8000

# =====================================================
# 代码沙箱（Code Node）
# 生产默认 container：代码在独立 Runner 容器中执行；不可用时失败关闭
# 本地开发未启动 Runner 时，可显式改为 vm（node:vm，非安全边界，仅限本地）
# =====================================================
LOOMFLOW_CODE_SANDBOX=container
SANDBOX_RUNNER_URL=http://sandbox-runner:8090
# 必须与 sandbox-runner 容器使用同一个值（openssl rand -hex 32）
SANDBOX_RUNNER_TOKEN=
SANDBOX_MAX_CONCURRENCY=2

# =====================================================
# 独立 Worker（异步任务队列）
# =====================================================
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_SHUTDOWN_GRACE_MS=30000

# =====================================================
# Agent Tools（Python 数据处理服务，可选）
# 启用：docker compose --profile ai-tools up -d
# =====================================================
AGENT_TOOLS_URL=http://agent-tools:8090
# 与 agent-tools 容器使用同一个值（openssl rand -hex 32）
AGENT_TOOLS_TOKEN=
# 宿主机调试端口（仅 127.0.0.1）
# AGENT_TOOLS_PORT=8091

# =====================================================
# Model Gateway
# =====================================================
# 模型价格（每 100 万 token，JSON）；不配置则成本标记为未知
# MODEL_PRICING_JSON={"deepseek-v4-flash":{"inputPer1M":0.14,"outputPer1M":0.28,"currency":"USD"}}
#
# 允许使用内网 baseURL 的 provider（逗号分隔；默认 ollama）
# 其他 provider 的自定义 baseURL 会做 SSRF 校验，指向内网直接拒绝
MODEL_ALLOW_PRIVATE_HOSTS=ollama

# =====================================================
# MCP（Model Context Protocol）
# =====================================================
# 域名白名单（可选，逗号分隔）：配置后只允许连接这些域名下的 MCP Server
# MCP_ALLOWED_HOSTS=mcp.example.com
#
# STDIO Server 的可执行文件白名单（仅部署级配置生效）
MCP_STDIO_ALLOWLIST=npx,node,uvx
# STDIO Server 定义（普通用户无法通过 API 添加）
# MCP_STDIO_SERVERS_JSON=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"],"scope":"read"}]

# =====================================================
# OpenTelemetry（默认关闭）
# =====================================================
# 开启后 Web / Worker / Python 工具服务统一导出到 OTLP Collector
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# 采样率（0-1，默认 0.1）
# OTEL_SAMPLING_RATIO=0.1
# Metrics 导出间隔（毫秒）
# OTEL_METRIC_EXPORT_INTERVAL=30000
