# Tinyflow 后端服务环境变量

# ===== Coze SDK 认证 (LLM / Web Search 等集成服务) =====
# 从 Coze 平台获取
COZE_AUTH_TOKEN=your_coze_auth_token
COZE_API_BASE=https://api.coze.cn

# ===== Coze 工作流配置 =====
# Personal Access Token（Coze 平台 → 个人设置 → API Token）
PAT_TOKEN=your_pat_token

# 备用 API Key（PAT_TOKEN 不存在时使用）
COZE_API_KEY=

# 测试模式（true 时工作流以测试模式运行，不计费）
COZE_WORKFLOW_TEST_MODE=true

# Coze 部署站点 URL（用于 SSE 代理调用）
BASE_URL=https://xxxxxxxxxx.coze.site

# ===== 环境标识 =====
# 开发环境: DEV / 生产环境: PROD
COZE_PROJECT_ENV=DEV

# ===== 服务端口 =====
# 沙箱自动注入, 无需手动设置
# DEPLOY_RUN_PORT=5000
