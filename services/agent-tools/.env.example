# 本地开发配置（Docker 部署由根 .env 注入）
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# 与 Node.js 侧 AGENT_TOOLS_TOKEN 保持一致
KNOWLEDGE_SERVICE_TOKEN=dev-only-token-change-me-0123456789

# 资源上限（可按机器调整）
MAX_INPUT_BYTES=8388608
MAX_ROWS=200000
MAX_TEXT_CHARS=400000
TOOL_TIMEOUT_SECONDS=25
ENABLE_DOCS=true
