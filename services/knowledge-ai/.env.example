# =====================================================
# Knowledge AI 服务本地配置模板（仅本地 uv 开发使用）
# cp .env.example .env
# Docker 部署由根目录 .env / docker-compose 注入，无需本文件
# =====================================================

# development | test | production
# production 下缺少 KNOWLEDGE_SERVICE_TOKEN 会直接启动失败
APP_ENV=development

LOG_LEVEL=INFO
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# 内部服务密钥：与 Node.js 侧的 KNOWLEDGE_SERVICE_TOKEN 保持一致
# 生成方式：openssl rand -hex 32
KNOWLEDGE_SERVICE_TOKEN=dev-only-token-change-me-0123456789

# 本地开发保留 /docs；生产建议 false
ENABLE_DOCS=true
